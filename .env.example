# StudyPilot AI - Environment Configuration
# Team Codex, Sanjay Ghodawat University

# Google Gemini API Key (Server-Side Environment Variable)
# Configure this in your Vercel Project Settings > Environment Variables
# or locally in a .env.local file (never commit your live key to Git)
GEMINI_API_KEY=your_gemini_api_key_here

# Web Search Fallback
# When a student asks a question NOT found in their uploaded PDF, StudyPilot AI
# automatically performs a web search using Gemini's built-in Google Search grounding.
# No additional API key is required — this reuses the GEMINI_API_KEY above.

# Neon PostgreSQL Database Connection (Server-Side Environment Variable)
# Automatically injected by Vercel when connecting a Neon Postgres database,
# or configured in .env.local for local development.
# Priority: POSTGRES_URL > DATABASE_URL > POSTGRES_PRISMA_URL > POSTGRES_URL_NON_POOLING
# Never expose these variables to the client or commit live credentials to Git.
POSTGRES_URL=postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require
# Alternative connection aliases supported by StudyPilot AI:
# DATABASE_URL=postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require
# POSTGRES_PRISMA_URL=postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
# POSTGRES_URL_NON_POOLING=postgresql://user:password@endpoint-direct.region.aws.neon.tech/neondb?sslmode=require
# Google OAuth 2.0 Credentials (Server-Side Environment Variables)
# Create OAuth 2.0 Client ID in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins:
#   - Production: https://study-pilot-ai-pearl.vercel.app
#   - Local: http://localhost:5173
# Authorized Redirect URIs:
#   - Production: https://study-pilot-ai-pearl.vercel.app/api/auth/google/callback
#   - Local: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional explicit application URL (defaults dynamically to incoming request host):
APP_URL=https://study-pilot-ai-pearl.vercel.app
